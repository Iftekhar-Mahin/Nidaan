# ─── Database (Neon / Railway PostgreSQL) ───────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nidaan?sslmode=require"

# ─── App Metadata ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Nidaan (নিদান)"
NEXT_PUBLIC_APP_TAGLINE="AI-Powered Prescription Scanner & Generic Drug Finder for Bangladesh"

# ─── FastAPI Backend (Railway) ────────────────────────────────────────────────
OCR_SERVICE_URL="https://your-backend.railway.app"
FRONTEND_URL="https://your-app.vercel.app"

# ─── Google Gemini AI ────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-api-key-here"

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://your-app.vercel.app"
